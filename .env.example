# Copy to .env and fill in. All are optional for local dev:
# with none set, the app uses a local JSON file store and static (non-LLM) copy.

# Railway Postgres (production persistence). If unset, a local ./data JSON store is used.
DATABASE_URL=

# OpenRouter (LLM personalization). If unset, generate.js uses deterministic static copy.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=google/gemini-3.5-flash-lite

# Public base URL used when emitting partner links (no trailing slash).
BASE_URL=http://localhost:4000

# Guards the /admin/stats and /admin/leads endpoints. If unset, they are disabled.
RAINPARTNERS_ADMIN_KEY=

# Salt for hashing visitor IPs (privacy: raw IPs are never stored).
IP_SALT=change-me

# Where partner CTAs point (booking link). Overridable per-page by enrichment.
DEFAULT_CTA_URL=https://rainnetworks.com/

# Resend (transactional email): notifies you when a partner submits the lead
# form. If any of the three are unset, notification is silently skipped and
# the lead is still saved. RESEND_FROM_EMAIL must be on a domain verified in
# your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFY_EMAIL=

PORT=4000
